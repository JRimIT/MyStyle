<%- include('../partials/header.ejs') %>

<div class="bodyAdmin">
  <!-- Truyền user mặc định là admin để tránh lỗi user is not defined -->
  <%- include('../partials/navbar.ejs', { user: { role: 'admin', name: 'Admin' } }) %>

  <div class="container mt-5 pt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>Edit Product</h2>
      <a href="/admin/products" class="btn btn-outline-secondary">Back to list</a>
    </div>

    <%
      // Chống crash nếu product chưa có
      const p = (typeof product !== 'undefined' && product) ? product : {};
    %>

    <div class="row">
      <div class="col-md-8">
        <div class="card">
          <div class="card-body">
            <form action="/admin/products/edit/<%= p._id %>" method="POST" enctype="multipart/form-data">
              <div class="mb-3">
                <label class="form-label">Name</label>
                <input name="name" value="<%= p.name || '' %>" class="form-control" required />
              </div>

              <div class="mb-3">
                <label class="form-label">Price</label>
                <input name="price" type="number" step="0.01" value="<%= (p.price != null ? p.price : '') %>" class="form-control" required />
              </div>

              <div class="mb-3">
                <label class="form-label">Category</label>
                <input name="category" value="<%= p.category || '' %>" class="form-control" />
              </div>

              <div class="mb-3">
                <label class="form-label">Image URL (or upload below)</label>
                <input name="imageUrl" value="<%= p.imageUrl || '' %>" class="form-control" placeholder="/uploads/.. or http(s)://..." />
                <!-- Giữ link ảnh cũ nếu không upload ảnh mới -->
                <input type="hidden" name="existingImageUrl" value="<%= p.imageUrl || '' %>" />
              </div>

              <div class="mb-3">
                <label class="form-label">Upload Image</label>
                <input name="image" type="file" accept="image/*" class="form-control" />
              </div>

              <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea name="description" rows="4" class="form-control"><%= p.description || '' %></textarea>
              </div>

              <button class="btn btn-primary" type="submit">Update Product</button>
            </form>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card">
          <div class="card-body text-center">
            <h6>Current Image</h6>
            <% if (p.imageUrl) { %>
              <img src="<%= p.imageUrl %>" alt="product image" class="img-fluid" />
            <% } else { %>
              <p class="text-muted">No image</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>

  </div>

  <%- include('../partials/footer.ejs') %>
</div>
