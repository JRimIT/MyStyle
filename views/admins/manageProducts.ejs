<%- include('../partials/header.ejs') %>

<div class="bodyAdmin">
  <!-- Truyền user vào partial để tránh "user is not defined" -->
  <%- include('../partials/navbar.ejs', { user: { role: 'admin', name: 'Admin' } }) %>

  <div class="container mt-5 pt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>Manage Products</h2>
    </div>

    <div class="row">
      <!-- Create / Add Product Form -->
      <div class="col-md-4">
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">Create Product</h5>
            <form action="/admin/products/create" method="POST">
              <div class="mb-3">
                <label class="form-label">Name</label>
                <input name="name" class="form-control" required />
              </div>

              <div class="mb-3">
                <label class="form-label">Price</label>
                <input name="price" type="number" step="0.01" class="form-control" required />
              </div>

              <div class="mb-3">
                <label class="form-label">Category</label>
                <input name="category" class="form-control" />
              </div>

              <div class="mb-3">
                <label class="form-label">Image URL</label>
                <input name="imageUrl" class="form-control" placeholder="/uploads/... hoặc http(s)://..." />
              </div>

              <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea name="description" rows="3" class="form-control"></textarea>
              </div>

              <button class="btn btn-primary" type="submit">Create</button>
            </form>
          </div>
        </div>
      </div>

      <!-- Product List -->
      <div class="col-md-8">
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">Products</h5>

            <% 
              const list = Array.isArray(products) ? products : [];
            %>

            <% if (list.length === 0) { %>
              <p class="text-muted">No products found.</p>
            <% } else { %>
              <div class="table-responsive">
                <table class="table table-striped">
                  <thead>
                    <tr>
                      <th>Name</th>
                      <th>Price</th>
                      <th>Category</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% list.forEach(function(p) { 
                         const priceText = (p && p.price != null) ? Number(p.price).toLocaleString('vi-VN') + ' VND' : '';
                         const sizeText = Array.isArray(p?.sizes) ? p.sizes.join(', ') : '';
                    %>
                      <tr>
                        <td><%= p?.name || '' %></td>
                        <td><%= priceText %></td>
                        <td><%= p?.category || '' %></td>
                        <td><%= sizeText %></td>
                        <td class="text-end">
                          <a class="btn btn-sm btn-outline-secondary me-2" href="/admin/products/edit/<%= p?._id %>">Edit</a>

                          <form action="/admin/products/delete/<%= p?._id %>" method="POST" style="display:inline-block" onsubmit="return confirm('Delete this product?')">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                          </form>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>

          </div>
        </div>
      </div>
    </div>

  </div>

  <%- include('../partials/footer.ejs') %>
</div>
