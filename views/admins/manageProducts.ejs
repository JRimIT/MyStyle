<%- include('../partials/header.ejs') %>

<div class="bodyAdmin">

  <%- include('../partials/navbar.ejs', { user: { role: 'admin', name: 'Admin' } }) %>

  <% // ===== SAFE DEFAULTS ===== %>
  <%
    const _limit = Number(typeof limit  !== 'undefined' ? limit  : 10);
    const _page  = Number(typeof page   !== 'undefined' ? page   : 1);
    const _total = Number(typeof total  !== 'undefined' ? total  : (Array.isArray(products) ? products.length : 0));
    const _search   = (typeof search   !== 'undefined' ? search   : '');
    const _category = (typeof category !== 'undefined' ? category : '');
    const _active   = (typeof active   !== 'undefined' ? active   : undefined);

    let _baseUrl = typeof baseUrl !== 'undefined' ? baseUrl : (() => {
      const qs = new URLSearchParams();
      qs.set('limit', _limit);
      if (_search) qs.set('search', _search);
      if (_category) qs.set('category', _category);
      if (typeof _active !== 'undefined') qs.set('active', _active);
      return '/admin/products?' + qs.toString();
    })();
    function pageLink(p){ return `${_baseUrl}&page=${p}`; }
  %>

  <div class="container mt-5 pt-5">

    <!-- alert -->
    <div id="alertBox" class="alert d-none position-sticky top-0" style="z-index:1030" role="alert"></div>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>Manage Products</h2>
      <a href="/admin/products/create" class="btn btn-success">+ Create New Product</a>
    </div>


    <% const list = Array.isArray(products) ? products : []; %>

    <% if (!list.length) { %>
      <p class="text-muted">No products found.</p>
    <% } else { %>
      <div class="table-responsive shadow-sm">
        <table class="table table-striped align-middle">
          <thead class="table-dark">
            <tr>
              <th class="text-center">Image</th>
              <th>Name</th>
              <th>ID</th>
              <th>Category</th>
              <th>Price</th>
              <th>Sizes</th>
              <th>Badges</th>
              <th>Description</th>
              <th>Created</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% list.forEach(p => {
                const priceText  = p?.price != null ? Number(p.price).toLocaleString('vi-VN') + ' VND' : '—';
                const sizesArr   = Array.isArray(p?.sizes) ? p.sizes : [];
                const badgesArr  = Array.isArray(p?.badges) ? p.badges : [];
                const desc       = (p?.description || '').trim();
                const descShort  = desc ? (desc.length > 80 ? desc.slice(0,80) + '…' : desc) : '—';
            %>
              <tr data-row-id="<%= p._id %>">
                <td class="text-center">
                  <% if (p.imageUrl) { %>
                    <img src="<%= p.imageUrl %>" alt="thumb" style="width:64px;height:64px;object-fit:cover;border-radius:8px;">
                  <% } else { %>
                    <div class="bg-light text-secondary d-inline-flex justify-content-center align-items-center"
                         style="width:64px;height:64px;border-radius:8px;">N/A</div>
                  <% } %>
                </td>
                <td class="fw-semibold"><%= p.name || '' %></td>
                <td class="small text-muted"><%= p._id || '' %></td>
                <td><%= p.category || '—' %></td>
                <td><%= priceText %></td>
                <td><%= sizesArr.length ? sizesArr.join(', ') : '—' %></td>
                <td><%= badgesArr.length ? badgesArr.join(', ') : '—' %></td>
                <td class="small" title="<%= desc %>"><%= descShort %></td>
                <td><%= p.createdAt ? new Date(p.createdAt).toLocaleDateString('vi-VN') : '—' %></td>
                <td class="text-end">
                  <!-- ĐỔI: Edit sang productCrud -->
                  <a class="btn btn-sm btn-outline-secondary me-2" href="/admin/products/edit/<%= p?._id %>">Edit</a>

                  <!-- Delete vẫn fetch tới productCrud -->
                  <button type="button" class="btn btn-sm btn-danger js-del" data-id="<%= p._id %>" data-name="<%= p.name %>">Delete</button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <!-- Nút trang trước / trang kế -->
    <%
      const totalPages = Math.max(Math.ceil((_total || 0) / (_limit || 10)), 1);
    %>
    <div class="text-center my-4">
      <% if (_page > 1) { %>
        <a href="<%= pageLink(_page - 1) %>" class="btn btn-outline-secondary me-2">← Trang trước</a>
      <% } %>
      <% if (_page < totalPages) { %>
        <a href="<%= pageLink(_page + 1) %>" class="btn btn-primary">Xem trang <%= _page + 1 %> →</a>
      <% } else { %>
        <button class="btn btn-secondary" disabled>Hết sản phẩm</button>
      <% } %>
    </div>

  </div>

  <%- include('../partials/footer.ejs') %>
</div>


<!-- Delete Confirm Modal -->
<div class="modal fade" id="delModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Xác nhận xoá</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        Bạn có chắc chắn muốn xoá sản phẩm "<span id="delName" class="fw-semibold"></span>"?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="btnDoDelete">Delete</button>
      </div>
    </div>
  </div>
</div>

<script>
  let delId = null;
  let delRow = null;

  function showAlert(type, msg) {
    const el = document.getElementById('alertBox');
    el.className = 'alert alert-' + type;
    el.textContent = msg;
    el.classList.remove('d-none');
    setTimeout(() => el.classList.add('d-none'), 2200);
  }

  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.js-del');
    if (!btn) return;
    delId = btn.dataset.id;
    delRow = document.querySelector(`[data-row-id="${CSS.escape(delId)}"]`);
    document.getElementById('delName').textContent = btn.dataset.name || '';
    new bootstrap.Modal(document.getElementById('delModal')).show();
  });

  document.getElementById('btnDoDelete').addEventListener('click', async () => {
    try {
      const res = await fetch(`/productCrud/${encodeURIComponent(delId)}`, {
        method: 'DELETE',
        headers: { 'Accept': 'application/json' }
      });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      if (delRow) delRow.remove();
      bootstrap.Modal.getInstance(document.getElementById('delModal')).hide();
      showAlert('success', 'Đã xoá sản phẩm thành công.');
      setTimeout(() => { window.location.reload(); }, 800);
    } catch (err) {
      console.error(err);
      bootstrap.Modal.getInstance(document.getElementById('delModal')).hide();
      showAlert('danger', 'Xoá thất bại. Vui lòng thử lại.');
    }
  });
</script>

