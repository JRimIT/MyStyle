<%- include('../partials/header.ejs') %>

<div class="bodyAdmin">
  <%- include('../partials/navbar.ejs', { user: { role: 'admin', name: 'Admin' } }) %>

  <div class="container mt-5 pt-5">
    <!-- Alert -->
    <div id="alertBox" class="alert d-none position-sticky top-0" style="z-index: 1030" role="alert"></div>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>Manage Users</h2>
      <a href="/admin/users/create" class="btn btn-success">+ Create New User</a>
    </div>

    <% const list = Array.isArray(users) ? users : []; %>
    <% if (!list.length) { %>
      <p class="text-muted">No users found.</p>
    <% } else { %>
      <div class="table-responsive shadow-sm">
        <table class="table table-striped align-middle">
          <thead class="table-dark">
            <tr>
              <th>ID</th>
              <th>Username</th>
              <th>Email</th>
              <th>Role</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% list.forEach(u => { %>
              <tr data-row-id="<%= u._id %>">
                <td class="small text-muted"><%= u._id %></td>
                <td class="fw-semibold"><%= u.username %></td>
                <td><%= u.email %></td>
                <td>
                  <span class="badge bg-<%= u.role === 'admin' ? 'danger' : 'secondary' %>">
                    <%= u.role %>
                  </span>
                </td>
                <td class="text-end">
                  <a class="btn btn-sm btn-outline-primary me-2" href="/admin/users/edit/<%= u._id %>">
                    View / Edit
                  </a>
                  <button 
                    type="button" 
                    class="btn btn-sm btn-danger js-del" 
                    data-id="<%= u._id %>"
                    data-name="<%= u.username %>"
                  >
                    Delete
                  </button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <%- include('../partials/footer.ejs') %>
</div>

<!-- Delete Confirm Modal -->
<div class="modal fade" id="delModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Confirm Delete</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        Are you sure you want to delete user "<span id="delName" class="fw-semibold"></span>"?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="btnDoDelete">Delete</button>
      </div>
    </div>
  </div>
</div>

<script>
  let delId = null;
  let delRow = null;

  function showAlert(type, msg) {
    const el = document.getElementById('alertBox');
    el.className = 'alert alert-' + type;
    el.textContent = msg;
    el.classList.remove('d-none');
    setTimeout(() => el.classList.add('d-none'), 2200);
  }

  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.js-del');
    if (!btn) return;
    delId = btn.dataset.id;
    delRow = document.querySelector(`[data-row-id="${CSS.escape(delId)}"]`);
    document.getElementById('delName').textContent = btn.dataset.name || '';
    new bootstrap.Modal(document.getElementById('delModal')).show();
  });

  document.getElementById('btnDoDelete').addEventListener('click', async () => {
    try {
      const res = await fetch(`/admin/users/delete/${encodeURIComponent(delId)}`, {
        method: 'POST',
        headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
      });

      if (!res.ok) throw new Error('HTTP ' + res.status);

      if (delRow) delRow.remove();
      bootstrap.Modal.getInstance(document.getElementById('delModal')).hide();
      showAlert('success', 'User deleted successfully.');
    } catch (err) {
      console.error(err);
      bootstrap.Modal.getInstance(document.getElementById('delModal')).hide();
      showAlert('danger', 'Delete failed. Please try again.');
    }
  });
</script>
