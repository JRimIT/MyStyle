<%- include('partials/header') %>
<%- include('partials/navbar') %>

<!-- spacer to avoid fixed-top navbar overlay -->
<div style="height:80px"></div>

<%
  const checkoutMode =
    typeof successMode !== "undefined"
      ? successMode
      : typeof bankCode !== "undefined" || typeof transNo !== "undefined"
        ? "payment"
        : "cod";
  const headingText =
    checkoutMode === "cod" ? "Đặt hàng thành công" : "Thanh toán thành công";
  const subText =
    checkoutMode === "cod"
      ? "Đơn hàng của bạn đã được ghi nhận. Chúng tôi sẽ liên hệ giao hàng trong thời gian sớm nhất."
      : "Cảm ơn bạn đã tin tưởng MyStyle!";
  const infoText =
    checkoutMode === "cod"
      ? "Bạn sẽ thanh toán trực tiếp cho shipper khi nhận hàng. Vui lòng chuẩn bị tiền mặt đúng giá trị đơn."
      : "Xác nhận đã được gửi tới email (nếu có). Bạn có thể theo dõi trạng thái đơn tại 'Đơn hàng của tôi'.";
  const amountText =
    typeof amount !== "undefined" && amount !== null
      ? `${Number(amount).toLocaleString("vi-VN")} VND`
      : null;
  const walletBalanceText =
    typeof walletBalance !== "undefined" && walletBalance !== null
      ? `${Number(walletBalance).toLocaleString("vi-VN")} VND`
      : null;
  const orderCodeVal = typeof orderCode !== "undefined" ? orderCode : null;
  const transNoVal = typeof transNo !== "undefined" ? transNo : null;
  const bankCodeVal = typeof bankCode !== "undefined" ? bankCode : null;
  const payDateVal = typeof payDate !== "undefined" ? payDate : null;
%>

<style>
  .success-hero {
    background: linear-gradient(135deg, #f0fff4 0%, #e6fffa 100%);
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 16px;
  }
  .success-card {
    max-width: 680px;
    border: 0;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0,0,0,.08);
    overflow: hidden;
  }
  .success-head {
    background: linear-gradient(135deg, #22c55e, #16a34a);
    color: #fff;
    padding: 28px 24px;
  }
  .success-icon {
    width: 64px; height: 64px;
    display: inline-flex; align-items:center; justify-content:center;
    border-radius: 50%; background: #fff; color: #16a34a;
    box-shadow: 0 6px 16px rgba(0,0,0,.12);
    animation: pop .5s ease-out;
  }
  @keyframes pop { 0%{transform:scale(.6); opacity:.2} 100%{transform:scale(1); opacity:1} }
  .kv { color:#64748b; }
  .kv strong { color:#0f172a; }
  .btn-wrap .btn { min-width: 180px; }
  .meta-grid { display:grid; grid-template-columns: 1fr 1fr; gap:12px; }
  @media (max-width: 576px){ .meta-grid { grid-template-columns: 1fr; } }
  .divider { height:1px; background:#e2e8f0; margin: 16px 0; }
  .badge-bank { background:#eef2ff; color:#3730a3; }
  .text-muted-2 { color:#6b7280; }
  .bg-soft { background:#f8fafc; }
</style>

<section class="success-hero">
  <div class="card success-card w-100">
    <div class="success-head text-center">
      <div class="d-inline-block success-icon mb-3">
        <i class="fas fa-check fa-2x"></i>
      </div>
      <h2 class="mb-1"><%= headingText %></h2>
      <p class="mb-0"><%= subText %></p>
    </div>
    <div class="card-body p-4 p-md-5 bg-white">
      <div class="meta-grid">
        <% if (orderCodeVal) { %>
          <div class="kv">Mã đơn hàng<br/><strong><%= orderCodeVal %></strong></div>
        <% } %>
        <% if (amountText) { %>
          <div class="kv">Số tiền<br/><strong><%= amountText %></strong></div>
        <% } %>
        <% if (transNoVal) { %>
          <div class="kv">Mã giao dịch<br/><strong><%= transNoVal %></strong></div>
        <% } %>
        <% if (bankCodeVal) { %>
          <div class="kv">Phương thức/Ngân hàng<br/>
            <span class="badge badge-bank rounded-pill px-3 py-2"><i class="fas fa-building me-2"></i><%= bankCodeVal %></span>
          </div>
        <% } %>
        <% if (payDateVal) { %>
          <div class="kv">Thời gian thanh toán<br/><strong><%= payDateVal %></strong></div>
        <% } %>
      </div>

      <div class="divider"></div>

      <div class="bg-soft rounded p-3 small text-muted-2">
        <i class="fas fa-info-circle me-2"></i>
        <%= infoText %>
      </div>
      <% if (checkoutMode === "wallet" && amountText) { %>
        <div class="alert alert-success mt-3 mb-0 small">
          Ví MyStyle của bạn đã được trừ <strong><%= amountText %></strong>.
          <% if (walletBalanceText) { %>
            Số dư còn lại: <strong><%= walletBalanceText %></strong>.
          <% } %>
        </div>
      <% } %>

      <div class="d-flex flex-wrap gap-2 gap-md-3 justify-content-center mt-4 btn-wrap">
        <a href="/orders" class="btn btn-primary">
          <i class="fas fa-receipt me-2"></i> Đơn hàng của tôi
        </a>
        <a href="/Home" class="btn btn-outline-secondary">
          <i class="fas fa-shopping-bag me-2"></i> Tiếp tục mua sắm
        </a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
