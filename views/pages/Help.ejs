<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Help - MyStyle</title>

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/navbar.css" />
    <link rel="stylesheet" href="/css/Help.css" />
    <link rel="stylesheet" href="/css/footer.css" />
  </head>
  <body>
    <!-- Navbar -->
    <%- include('../partials/navbar.ejs') %>

    <!-- Search Section -->
    <div class="help-search-section text-center">
      <h1 class="mb-3">NEED HELP?</h1>
      <div class="search-box">
        <input
          type="text"
          id="searchInput"
          class="form-control"
          placeholder="What can we help you with today?"
        />
      </div>
    </div>

    <!-- Help Content -->
    <div class="help-content container py-5">
      <h2 class="mb-4">Quick Assists</h2>
      <div class="row" id="faqContainer">
        <!-- FAQ Group 1 -->
        <div
          class="col-md-4 mb-4 faq-item"
          data-keywords="return exchange refund policy size"
        >
          <h5>Returns & Exchanges</h5>
          <ul class="list-unstyled">
            <li
              class="faq-question"
              data-answer="You can return or exchange any item within 7 days of delivery, provided it is unworn and with original tags."
            >
              What is your return policy?
            </li>
            <li
              class="faq-question"
              data-answer="Log in to your account, go to Orders, and click 'Request Return'."
            >
              How do I return an item?
            </li>
            <li
              class="faq-question"
              data-answer="Refunds are processed within 3–5 business days after we receive and inspect your returned items."
            >
              When will I receive my refund?
            </li>
            <li
              class="faq-question"
              data-answer="Yes, you can exchange for a different size or color within 7 days."
            >
              Can I exchange for another size or color?
            </li>
            <li
              class="faq-question"
              data-answer="Some promotional or clearance items are not eligible for returns unless defective."
            >
              Are sale items eligible for return?
            </li>
          </ul>
        </div>

        <!-- FAQ Group 2 -->
        <div
          class="col-md-4 mb-4 faq-item"
          data-keywords="delivery shipping order tracking"
        >
          <h5>Shipping & Delivery</h5>
          <ul class="list-unstyled">
            <li
              class="faq-question"
              data-answer="We offer standard (3–5 business days) and express (1–2 business days) delivery nationwide."
            >
              What are your delivery options?
            </li>
            <li
              class="faq-question"
              data-answer="You can track your order in the 'My Orders' section or via the link in your confirmation email."
            >
              How can I track my order?
            </li>
            <li
              class="faq-question"
              data-answer="Orders over $50 qualify for free standard delivery."
            >
              Do you offer free shipping?
            </li>
            <li
              class="faq-question"
              data-answer="Yes, we ship internationally to select countries. Delivery time depends on the destination."
            >
              Do you ship internationally?
            </li>
            <li
              class="faq-question"
              data-answer="If your order hasn't arrived, please contact our support team with your order number."
            >
              My order hasn’t arrived — what should I do?
            </li>
          </ul>
        </div>

        <!-- FAQ Group 3 -->
        <div
          class="col-md-4 mb-4 faq-item"
          data-keywords="order cancel payment method"
        >
          <h5>Orders & Payments</h5>
          <ul class="list-unstyled">
            <li
              class="faq-question"
              data-answer="You can view all your orders by logging into your MyStyle account and navigating to 'My Orders'."
            >
              Where can I view my orders?
            </li>
            <li
              class="faq-question"
              data-answer="Orders can be cancelled within 12 hours after placing them. Contact our support team as soon as possible."
            >
              Can I cancel or modify my order?
            </li>
            <li
              class="faq-question"
              data-answer="We accept Visa, MasterCard, PayPal, and MyStyle gift cards."
            >
              What payment methods do you accept?
            </li>
            <li
              class="faq-question"
              data-answer="Once your order has been shipped, you will receive a confirmation email with tracking information."
            >
              Will I get a confirmation email?
            </li>
            <li
              class="faq-question"
              data-answer="Sometimes, orders with multiple items may arrive in separate packages."
            >
              Why did I receive only part of my order?
            </li>
          </ul>
        </div>

        <!-- FAQ Group 4 -->
        <div
          class="col-md-4 mb-4 faq-item"
          data-keywords="account password profile membership"
        >
          <h5>Account & Membership</h5>
          <ul class="list-unstyled">
            <li
              class="faq-question"
              data-answer="Click on 'Sign Up' at the top of our homepage and fill in the required details."
            >
              How do I create a MyStyle account?
            </li>
            <li
              class="faq-question"
              data-answer="Go to 'My Account' > 'Edit Profile' to update your name, email, or password."
            >
              How can I update my account details?
            </li>
            <li
              class="faq-question"
              data-answer="Click 'Forgot Password' on the login page and follow the steps to reset it."
            >
              I forgot my password — what should I do?
            </li>
            <li
              class="faq-question"
              data-answer="MyStyle members get exclusive discounts, early sale access, and reward points on every purchase."
            >
              What are the benefits of becoming a member?
            </li>
            <li
              class="faq-question"
              data-answer="Yes, you can delete your account anytime by contacting customer support."
            >
              Can I delete my account?
            </li>
          </ul>
        </div>

        <!-- FAQ Group 5 -->
        <div
          class="col-md-4 mb-4 faq-item"
          data-keywords="size chart fitting material product info"
        >
          <h5>Products & Size Guide</h5>
          <ul class="list-unstyled">
            <li
              class="faq-question"
              data-answer="You can find a detailed size chart on every product page, next to the 'Add to Cart' button."
            >
              Where can I find your size chart?
            </li>
            <li
              class="faq-question"
              data-answer="We recommend checking our Fit Guide for measurement tips and how to choose your ideal fit."
            >
              How do I know my size?
            </li>
            <li
              class="faq-question"
              data-answer="We clearly mention fabric composition on each product page under 'Product Details'."
            >
              What materials are your clothes made of?
            </li>
            <li
              class="faq-question"
              data-answer="If a product is out of stock, click 'Notify Me' to receive an alert when it’s available again."
            >
              What if my desired item is out of stock?
            </li>
            <li
              class="faq-question"
              data-answer="We do our best to display colors accurately, but slight variations may occur due to monitor settings."
            >
              Are product colors accurate?
            </li>
          </ul>
        </div>
      </div>

      <!-- Answer Panel -->
      <div id="faqAnswer" class="faq-answer-panel mt-4 d-none">
        <div class="card">
          <div class="card-body">
            <p id="answerText" class="mb-0"></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <%- include('../partials/footer') %>

    <!-- Script -->
    <script>
      // Show answer when question clicked
      document.querySelectorAll(".faq-question").forEach((q) => {
        q.addEventListener("click", () => {
          const answer = q.getAttribute("data-answer");
          document.getElementById("answerText").innerText = answer;
          document.getElementById("faqAnswer").classList.remove("d-none");
          window.scrollTo({
            top: document.getElementById("faqAnswer").offsetTop - 100,
            behavior: "smooth",
          });
        });
      });

      // Search filter
      document
        .getElementById("searchInput")
        .addEventListener("input", function () {
          const search = this.value.toLowerCase();
          const items = document.querySelectorAll(".faq-item");

          items.forEach((item) => {
            const keywords = item.getAttribute("data-keywords").toLowerCase();
            const questions = item.querySelectorAll(".faq-question");

            let matchFound = false;

            if (keywords.includes(search)) {
              matchFound = true;
            }

            questions.forEach((q) => {
              if (q.textContent.toLowerCase().includes(search)) {
                matchFound = true;
              }
            });

            item.style.display = matchFound || search === "" ? "block" : "none";
          });
        });
    </script>
  </body>
</html>
