<%- include('../partials/header') %>
<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center">
    <h3>Hóa đơn</h3>
    <button class="btn btn-outline-secondary" onclick="window.print()">In</button>
  </div>
  <div class="card shadow-sm">
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <p><strong>Mã đơn:</strong> <%= order._id %></p>
          <p><strong>Trạng thái:</strong> <%= order.status %></p>
          <p><strong>Thanh toán:</strong> <%= order.payment && order.payment.status || '-' %> (<%= order.payment && order.payment.via || '' %>)</p>
        </div>
        <div class="col-md-6">
          <p><strong>Người nhận:</strong> <%= order.shippingAddress && order.shippingAddress.fullName || '' %></p>
          <p><strong>SĐT:</strong> <%= order.shippingAddress && order.shippingAddress.phone || '' %></p>
          <p><strong>Địa chỉ:</strong> <%= order.shippingAddress && order.shippingAddress.address || '' %></p>
        </div>
      </div>
      <hr/>
      <table class="table">
        <thead><tr><th>Sản phẩm</th><th class="text-end">Đơn giá</th><th class="text-end">SL</th><th class="text-end">Thành tiền</th></tr></thead>
        <tbody>
          <% (order.items||[]).forEach(it=>{ %>
            <tr>
              <td><%= (it.productId && it.productId.name) || it.name || it.productId %></td>
              <td class="text-end"><%= Number(it.price||0).toLocaleString('vi-VN') %></td>
              <td class="text-end"><%= it.qty %></td>
              <td class="text-end"><%= Number((it.price||0)*(it.qty||0)).toLocaleString('vi-VN') %></td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr><th colspan="3" class="text-end">Tổng</th><th class="text-end"><%= Number(order.total||0).toLocaleString('vi-VN') %> VND</th></tr>
        </tfoot>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>

