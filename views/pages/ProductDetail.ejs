<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<div style="height:80px"></div>

<div class="container my-3">
  <div class="row g-4">
    <div class="col-md-6">
      <img class="img-fluid rounded" src="/img?url=<%= encodeURIComponent(product.imageUrl||'') %>" alt="<%= product.name %>"/>
    </div>
    <div class="col-md-6">
      <h3><%= product.name %></h3>
      <% if (isCurrentlyOnSale && originalDisplayPrice) { %>
        <div><del><%= originalDisplayPrice.toLocaleString('vi-VN') %> VND</del></div>
        <div class="fs-4 fw-bold text-danger"><%= Math.round(displayPrice).toLocaleString('vi-VN') %> VND</div>
      <% } else { %>
        <div class="fs-4 fw-bold"><%= Number(displayPrice||product.price||0).toLocaleString('vi-VN') %> VND</div>
      <% } %>
      <p class="mt-3"><%= product.description || '' %></p>
      <div class="mt-3">
        <a class="btn btn-outline-secondary" href="/listFeatureClothes">Quay lại</a>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

