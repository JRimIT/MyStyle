<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Profile - My Style</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/navbar.css" />
    <link rel="stylesheet" href="/css/profile.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    />
  </head>
  <body style="display: flex; flex-direction: column; min-height: 100vh;">
    <%- include('../partials/navbar') %>

    <div class="container mt-5 pt-4 profile-container" style="max-width: 1100px; flex: 1; margin-bottom: 2rem;">
      <div class="card shadow-lg">
        <div class="row g-0">
          <!-- Left Column: Avatar & Info -->
          <div class="col-md-4 profile-sidebar">
            <div class="profile-avatar-wrapper">
              <div class="avatar-ring">
                <img
                  src="<%= user.avatarUrl || 'https://cdn-icons-png.flaticon.com/512/149/149071.png' %>"
                  class="profile-avatar"
                  alt="Avatar"
                />
              </div>
            </div>
            <h4 class="profile-name"><%= user.fullName || user.username %></h4>
            <p class="profile-email"><i class="fas fa-envelope me-2"></i><%= user.email || "..." %></p>
            
            <div class="profile-divider"></div>
            
            <div class="profile-info-list">
              <div class="info-item">
                <i class="fas fa-shield-alt info-icon"></i>
                <div class="info-content">
                  <span class="info-label">Role</span>
                  <span class="badge role-badge"><%= user.role %></span>
                </div>
              </div>
              <div class="info-item">
                <i class="fas fa-calendar-alt info-icon"></i>
                <div class="info-content">
                  <span class="info-label">Joined</span>
                  <span class="info-value"><%= user.createdAt ? user.createdAt.toLocaleDateString() : '...' %></span>
                </div>
              </div>
              <div class="info-item wallet-info">
                <i class="fas fa-wallet info-icon"></i>
                <div class="info-content">
                  <span class="info-label">Số dư ví</span>
                  <span class="info-value balance"><%= user.balance ? user.balance.toLocaleString() : 0 %> VND</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Edit Form -->
          <div class="col-md-8 profile-form-section">
            <h5 class="form-section-title">
              <i class="fas fa-user-edit me-2"></i>Thông tin cá nhân
            </h5>
            <form action="/profile/update" method="POST">
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label">
                    <i class="fas fa-user me-2"></i>Username
                  </label>
                  <input type="text" class="form-control" name="username" value="<%= user.username %>" readonly />
                </div>

                <div class="col-md-6 mb-3">
                  <label class="form-label">
                    <i class="fas fa-id-card me-2"></i>Full Name
                  </label>
                  <input type="text" class="form-control" name="fullName" value="<%= user.fullName || '' %>" placeholder="Enter your full name" />
                </div>

                <div class="col-md-6 mb-3">
                  <label class="form-label">
                    <i class="fas fa-envelope me-2"></i>Email
                  </label>
                  <input type="email" class="form-control" name="email" value="<%= user.email || '' %>" placeholder="your.email@example.com" />
                </div>

                <div class="col-md-6 mb-3">
                  <label class="form-label">
                    <i class="fas fa-phone me-2"></i>Phone
                  </label>
                  <input type="text" class="form-control" name="phone" value="<%= user.phone || '' %>" placeholder="0933769962" />
                </div>

                <div class="col-md-8 mb-3">
                  <label class="form-label">
                    <i class="fas fa-map-marker-alt me-2"></i>Address
                  </label>
                  <input type="text" class="form-control" name="address" value="<%= user.address || '' %>" placeholder="Enter your address" />
                </div>

                <div class="col-md-4 mb-3">
                  <label class="form-label">
                    <i class="fas fa-mail-bulk me-2"></i>Post Code
                  </label>
                  <input type="text" class="form-control" name="postCode" value="<%= user.postCode || '' %>" placeholder="700000" />
                </div>

                <div class="col-md-6 mb-3">
                  <label class="form-label">
                    <i class="fas fa-birthday-cake me-2"></i>Date of Birth
                  </label>
                  <input type="date" class="form-control" name="dateOfBirth" 
                    value="<%= user.dateOfBirth ? new Date(user.dateOfBirth).toISOString().split('T')[0] : '' %>" />
                </div>

                <div class="col-md-6 mb-3">
                  <label class="form-label">
                    <i class="fas fa-image me-2"></i>Avatar URL
                  </label>
                  <input type="text" class="form-control" name="avatarUrl" value="<%= user.avatarUrl || '' %>" placeholder="https://example.com/avatar.jpg" />
                </div>

                <div class="col-12 mt-4">
                  <button type="submit" class="btn btn-update">
                    <i class="fas fa-save me-2"></i>Cập nhật thông tin
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <%- include('../partials/footer') %>
  </body>
</html>
