<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Profile - My Style</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/navbar.css" />
    <link rel="stylesheet" href="/css/profile.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    />
  </head>
  <body style="display: flex; flex-direction: column; min-height: 100vh;">
    <%- include('../partials/navbar') %>

    <div class="container mt-5 pt-4 profile-container" style="max-width: 1000px; flex: 1; margin-bottom: 2rem;">
      <div class="card shadow p-3">
        <div class="row">
          <!-- Left Column: Avatar & Info -->
          <div class="col-md-4 text-center border-end">
            <img
              src="<%= user.avatarUrl || 'https://cdn-icons-png.flaticon.com/512/149/149071.png' %>"
              class="rounded-circle mb-2"
              width="100"
              alt="Avatar"
            />
            <h5 class="mb-1"><%= user.fullName || user.username %></h5>
            <p class="text-muted small mb-2"><i class="fas fa-envelope me-1"></i> <%= user.email || "..." %></p>
            
            <hr class="my-2" />
            
            <div class="text-start">
              <p class="mb-2 small"><strong>Role:</strong> <span class="badge bg-primary"><%= user.role %></span></p>
              <p class="mb-2 small"><strong>Joined:</strong> <%= user.createdAt ? user.createdAt.toLocaleDateString() : '...' %></p>
              <p class="mb-2 small"><strong>Số dư ví:</strong> <span class="text-success fw-bold"><%= user.balance ? user.balance.toLocaleString() : 0 %> VND</span></p>
            </div>
          </div>

          <!-- Right Column: Edit Form -->
          <div class="col-md-8">
            <form action="/profile/update" method="POST">
              <div class="row">
                <div class="col-md-6 mb-2">
                  <label class="form-label small mb-1"><strong>Username:</strong></label>
                  <input type="text" class="form-control form-control-sm" name="username" value="<%= user.username %>" readonly />
                </div>

                <div class="col-md-6 mb-2">
                  <label class="form-label small mb-1"><strong>Full Name:</strong></label>
                  <input type="text" class="form-control form-control-sm" name="fullName" value="<%= user.fullName || '' %>" />
                </div>

                <div class="col-md-6 mb-2">
                  <label class="form-label small mb-1"><strong>Email:</strong></label>
                  <input type="email" class="form-control form-control-sm" name="email" value="<%= user.email || '' %>" />
                </div>

                <div class="col-md-6 mb-2">
                  <label class="form-label small mb-1"><strong>Phone:</strong></label>
                  <input type="text" class="form-control form-control-sm" name="phone" value="<%= user.phone || '' %>" />
                </div>

                <div class="col-md-8 mb-2">
                  <label class="form-label small mb-1"><strong>Address:</strong></label>
                  <input type="text" class="form-control form-control-sm" name="address" value="<%= user.address || '' %>" />
                </div>

                <div class="col-md-4 mb-2">
                  <label class="form-label small mb-1"><strong>Post Code:</strong></label>
                  <input type="text" class="form-control form-control-sm" name="postCode" value="<%= user.postCode || '' %>" />
                </div>

                <div class="col-md-6 mb-2">
                  <label class="form-label small mb-1"><strong>Date of Birth:</strong></label>
                  <input type="date" class="form-control form-control-sm" name="dateOfBirth" 
                    value="<%= user.dateOfBirth ? new Date(user.dateOfBirth).toISOString().split('T')[0] : '' %>" />
                </div>

                <div class="col-md-6 mb-2">
                  <label class="form-label small mb-1"><strong>Avatar URL:</strong></label>
                  <input type="text" class="form-control form-control-sm" name="avatarUrl" value="<%= user.avatarUrl || '' %>" placeholder="Image URL" />
                </div>

                <div class="col-12 mt-3">
                  <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-save me-2"></i>Cập nhật thông tin
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <%- include('../partials/footer') %>
  </body>
</html>
