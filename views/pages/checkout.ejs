<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<!-- spacer to avoid navbar overlay -->
<div style="height:80px"></div>

<style>
  .co-hero { background: linear-gradient(135deg,#eef2ff,#e0f2fe); padding: 24px 0; }
  .co-title { font-weight:700; margin:0; }
  .co-card { border:0; border-radius:16px; box-shadow:0 10px 30px rgba(0,0,0,.08); }
  .co-note { color:#64748b; }
  .badge-vnp { background:#e0f2fe; color:#075985; }
  .btn-pay { min-width: 220px; }
  .small { font-size: .92rem; }
  .required:after { content:' *'; color:#ef4444; }
  .muted { color:#6b7280; }
</style>

<div class="co-hero">
  <div class="container">
    <h2 class="co-title">Checkout</h2>
    <p class="co-note mb-0">Vui lòng điền thông tin nhận hàng và chọn phương thức thanh toán.</p>
  </div>
  </div>

<div class="container my-4">
  <div class="card co-card">
    <div class="card-body p-4">
      <form id="checkoutForm" action="/checkout" method="POST" class="row g-3">
        <div class="col-md-6">
          <label class="form-label required">Họ tên</label>
          <input name="fullName" class="form-control" required>
        </div>
        <div class="col-md-3">
          <label class="form-label required">Số điện thoại</label>
          <input name="phone" class="form-control" required>
        </div>
        <div class="col-12">
          <label class="form-label required">Địa chỉ</label>
          <input name="address" class="form-control" required>
        </div>
        <div class="col-12">
          <label class="form-label">Ghi chú</label>
          <textarea name="note" class="form-control" rows="3" placeholder="Ghi chú cho đơn hàng (không bắt buộc)"></textarea>
        </div>

        <div class="col-12 mt-2">
          <h5 class="mb-2">Phuong th?c thanh to�n</h5>
          <% const walletBalance = Number((user && user.balance) || 0); %>
          <% const orderTotal = Number(total || 0); %>
          <% const canUseWallet = walletBalance >= orderTotal; %>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="paymentMethod" id="pmDirect" value="direct" checked>
            <label class="form-check-label" for="pmDirect">
              VNPay <span class="badge badge-vnp">Thanh to�n ngay</span>
            </label>
          </div>
          <div class="form-check mt-2">
            <input class="form-check-input" type="radio" name="paymentMethod" id="pmWallet" value="wallet" <%= canUseWallet ? "" : "disabled" %>>
            <label class="form-check-label" for="pmWallet">
              Ví MyStyle
              <span class="d-block small text-muted">
                Số dư: <strong><%= walletBalance.toLocaleString("vi-VN") %> VND</strong>
                <% if (!canUseWallet) { %>
                  (Số dư chưa đủ để thanh toán đơn hàng này)
                <% } else { %>
                  (Đủ để thanh toán toàn bộ)
                <% } %>
              </span>
            </label>
          </div>
          <div class="form-check mt-2">
            <input class="form-check-input" type="radio" name="paymentMethod" id="pmCod" value="cod">
            <label class="form-check-label" for="pmCod">
              Thanh toán khi nhận hàng (COD)
              <span class="d-block small text-muted">Phù hợp nếu bạn muốn kiểm tra hàng trước khi trả tiền.</span>
            </label>
          </div>
        </div>
        <div class="col-12 text-center mt-3">
          <button type="submit" class="btn btn-primary btn-pay">
            Xác nhận & Thanh toán
          </button>
          <p class="small muted mt-2 mb-0">Bạn sẽ được chuyển đến cổng VNPay để hoàn tất thanh toán.</p>
        </div>
      </form>
    </div>
  </div>

  <script>
    const walletInput = document.getElementById("pmWallet");
    if (walletInput && walletInput.disabled) {
      walletInput.closest(".form-check")?.classList.add("text-muted");
    }
  </script>
</div>

<%- include('../partials/footer') %>


