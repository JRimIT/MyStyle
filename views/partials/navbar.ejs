<!-- Bootstrap Bundle with Popper -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- Bootstrap Bundle with Popper -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script src="/js/searchBar.js"></script>
<link rel="stylesheet" href="/css/navbar.css" />

<nav class="navbar navbar-expand-lg navbar-custom fixed-top">
    <div class="container-fluid">
        <!-- Logo -->
        <a class="navbar-brand" href="/Home">
            <img src="/logo_mystyle.png" alt="Logo" width="40" height="40" />
        </a>

        <!-- Toggle for mobile -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar content -->
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item"><a class="nav-link" href="/Home">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="/menu">Menu</a></li>
                <li class="nav-item"><a class="nav-link" href="/about">About</a></li>
                <li class="nav-item"><a class="nav-link" href="/contact">Contact</a></li>
                <li class="nav-item"><a class="nav-link" href="/help">Help</a></li>

            </ul>
            <!-- Search bar + cart + user -->
            <div class="d-flex search-bar me-4 position-relative" role="search">
                <%- include('searchBar') %>
                    <% if (typeof cartCount !=='undefined' ) { %>
                        <div class="cart-icon position-relative me-3">
                            <a href="/view/cart" class="position-relative text-decoration-none text-dark">
                                <i class="fas fa-shopping-cart fa-lg"></i>
                                <span
                                    class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    <%= cartCount %>
                                </span>
                            </a>
                        </div>
                        <% } %>
                            <% if (user) { %>
                                <div class="d-flex align-items-center me-3">
                                    <div class="balance-display">
                                        <i class="fas fa-wallet text-success"></i>
                                        <span class="balance-amount" id="navBalance">
                                            <%= user.balance ? user.balance.toLocaleString('vi-VN') : 0 %>
                                        </span>
                                        <span class="text-muted">VND</span>
                                    </div>
                                </div>
                                <% } %>
            </div>

            <!-- Dropdown menu for Users -->
            <% if (user) { %>
                <div class="dropdown">
                    <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle" id="dropdownUser"
                        data-bs-toggle="dropdown" aria-expanded="false">
                        <img src="<%= user.avatarUrl || 'https://i.pinimg.com/1200x/dc/6c/b0/dc6cb0521d182f959da46aaee82e742f.jpg' %>"
                            alt="avatar" width="40" height="40" class="rounded-circle" />
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownUser">

                        <!-- Common items for all users -->
                        <li><a class="dropdown-item" href="/profile"><i class="fas fa-user"></i> Profile</a></li>
                        <li><a class="dropdown-item wallet-item" href="/wallet"><i class="fas fa-wallet"></i> Ví của
                                tôi</a></li>
                        <li>
                            <hr class="dropdown-divider" />
                        </li>

                        <!-- Role-based items -->
                        <% if (user.role==='shipper' ) { %>
                            <li><a class="dropdown-item" href="/shipper/dashboard"><i class="fas fa-truck"></i> Shipper
                                    Dashboard</a></li>
                            <% } else if (user.role==='admin' ) { %>
                                <li><a class="dropdown-item" href="/admin/statistics"><i class="fas fa-chart-line"></i>
                                        Statistics</a></li>
                                <li><a class="dropdown-item" href="/admin/manageUser"><i class="fas fa-users-cog"></i>
                                        Manage Users</a></li>
                                <li><a class="dropdown-item" href="/admin/products"><i class="fas fa-box"></i>
                                        Products</a></li>
                                <li><a class="dropdown-item" href="/admin/categories"><i class="fas fa-tags"></i>
                                        Categories</a></li>
                                <li><a class="dropdown-item" href="/admin/vouchers"><i class="fas fa-ticket-alt"></i>
                                        Voucher</a></li>
                                <% } else if (user.role==='customer' ) { %>
                                    <li><a class="dropdown-item" href="/orders"><i class="fas fa-shopping-bag"></i>
                                            Orders</a></li>
                                    <li><a class="dropdown-item" href="/wishlist"><i class="fas fa-heart"></i>
                                            Wishlist</a></li>
                                    <% } %>

                                        <li>
                                            <hr class="dropdown-divider" />
                                        </li>
                                        <!-- Logout -->
                                        <li><a class="dropdown-item text-danger" href="/logout"><i
                                                    class="fas fa-sign-out-alt"></i> Logout</a></li>
                    </ul>
                </div>

                <% } else { %>
                    <a href="/login" class="btn btn-outline-primary">Login</a>
                    <% } %>



        </div>
    </div>
</nav>